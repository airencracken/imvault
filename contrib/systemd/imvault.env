# Configuration for the systemd unit.
#
#   install -Dm640 contrib/systemd/imvault.env /etc/imvault/imvault.env
#   chown root:imvault /etc/imvault/imvault.env
#
# Everything in this file is optional: the defaults in the README are what the
# server uses when a setting is absent. Uncomment only what you want to change.
#
# This file is read by systemd, not by a shell. Quotes are supported;
# shell variable expansion and `export` are not.

# IMVAULT_ADDR=:8080

# Set this to the URL people actually browse, so share links are absolute.
# Required when email or an OpenID Connect provider is configured.
# IMVAULT_BASE_URL=https://img.example.com

# Enable when serving over HTTPS, behind a TLS-terminating proxy.
# IMVAULT_SECURE_COOKIES=true

# Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto are believed, as
# comma-separated addresses or CIDR prefixes. Empty trusts none. For a proxy on
# this host, as in the shipped examples:
# IMVAULT_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# IMVAULT_ALLOW_SIGNUP=false
# IMVAULT_ALLOW_ANONYMOUS_UPLOADS=true
# IMVAULT_ANONYMOUS_TTL=24h
# IMVAULT_DEFAULT_QUOTA_BYTES=5368709120
# IMVAULT_MAX_UPLOAD_BYTES=33554432
# IMVAULT_MAX_VIDEO_BYTES=134217728
# IMVAULT_MAX_VIDEO_DURATION=60s
# IMVAULT_UPLOAD_RATE_PER_HOUR=120
# IMVAULT_UPLOAD_BURST=20
# IMVAULT_LOG_LEVEL=info

# Email, for password reset and address confirmation. Leave unset and resets
# are issued by an administrator from the admin UI instead. Setting a relay
# requires IMVAULT_BASE_URL above, so mailed links point at this instance.
# IMVAULT_SMTP_HOST=smtp.example.com
# IMVAULT_SMTP_PORT=587
# IMVAULT_SMTP_USERNAME=imvault
# IMVAULT_SMTP_PASSWORD=changeme
# IMVAULT_SMTP_FROM=Imvault <no-reply@example.com>
# IMVAULT_SMTP_TLS=starttls

# Optional Linux confinement; see docs/sandbox.md.
# Whole-service confinement uses an ExecStart override; see docs/sandbox.md.
# IMVAULT_MEDIA_SANDBOX=true
# IMVAULT_BWRAP=/usr/bin/bwrap
