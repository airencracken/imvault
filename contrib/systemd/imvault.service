[Unit]
Description=Imvault image and clip host
Documentation=https://github.com/airencracken/imvault
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=imvault

# Create the account once, before enabling:
#   useradd --system --home-dir /var/lib/imvault --shell /usr/sbin/nologin imvault
User=imvault
Group=imvault
# Files the server creates (the database, its journal, uploaded objects) are
# readable by the service account alone.
UMask=0077

# Optional overrides. Anything here wins over the Environment= lines below.
EnvironmentFile=-/etc/imvault/imvault.env

# StateDirectory creates /var/lib/imvault with the right ownership and keeps it
# writable even under ProtectSystem=strict. It holds account credentials and
# private uploads, so nobody but the service account may list it; systemd also
# tightens an existing directory to this mode on start.
Environment=IMVAULT_DATA_DIR=/var/lib/imvault
StateDirectory=imvault
StateDirectoryMode=0700

ExecStart=/usr/local/bin/imvault

Restart=on-failure
RestartSec=5s
# The server gives requests in flight 15 seconds after SIGTERM, and the
# sandbox launcher waits up to 20 for the server; leave room for both.
TimeoutStopSec=25s

# --- Hardening -------------------------------------------------------------
#
# These are deliberately the safe subset. A system call filter
# (SystemCallFilter=@system-service) and MemoryDenyWriteExecute=yes are both
# reasonable additions, but Imvault shells out to ffmpeg for clip posters, and
# a filter that turns out to be too tight would break video silently. Add them
# only after checking the journal for EPERM after an upload.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# If you move the data directory, add it here or ProtectSystem=strict will make
# it read-only and the service will fail to start:
#   ReadWritePaths=/srv/imvault

[Install]
WantedBy=multi-user.target
